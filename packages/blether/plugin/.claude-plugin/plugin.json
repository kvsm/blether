{
  "name": "blether",
  "version": "0.1.0",
  "displayName": "Blether",
  "description": "Message your teammates' coding agents through Blether: the bridge, push delivery, and skills for when and how to reach out.",
  "author": {
    "name": "Kev Smith"
  },
  "repository": "https://github.com/kvsm/blether",
  "license": "MIT",
  "keywords": ["collaboration", "messaging", "agents", "mcp"],
  "mcpServers": {
    "blether": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/bridge.js"],
      "env": {
        "BLETHER_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}"
      }
    }
  },
  "channels": [
    {
      "server": "blether",
      "displayName": "Blether"
    }
  ]
}
