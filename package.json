{
  "name": "blether",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @kvsm/blether bundle",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "set-version": "node scripts/set-version.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@blether/bridge": "workspace:*",
    "@blether/protocol": "workspace:*",
    "@blether/relay": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/node": "^24.19.0",
    "@types/ws": "^8.18.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
